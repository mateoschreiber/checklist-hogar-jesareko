# Puerto local del servidor
APP_PORT=8080

# Zona horaria para registros del sistema
TZ=America/Asuncion

# Cambiar antes de producción. Generar con: openssl rand -hex 32
APP_SECRET=change-me-with-openssl-rand-hex-32

# Usuario inicial. Se crea solo si la base está vacía.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@hogar.local
ADMIN_PASSWORD=Cambiar-esta-clave-123

# Registro público de usuarios. Recomendado: false.
ALLOW_REGISTRATION=false

# Cookie segura. Usar true solo si se publica detrás de HTTPS.
COOKIE_SECURE=false

# Días de duración de sesión
SESSION_DAYS=30

# Ubicación interna del archivo SQLite persistente
DATABASE_PATH=/data/checklist.db
