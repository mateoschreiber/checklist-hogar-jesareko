LOCAL_ONLY=true
ADMIN_USER=admin
ADMIN_PASSWORD=admin
APP_PORT=8080

TZ=America/Asuncion
APP_SECRET=change-me-with-openssl-rand-hex-32
COOKIE_SECURE=false
SESSION_DAYS=30
DATABASE_PATH=/data/checklist.db
BACKUP_DIR=/backups
BACKUP_KEEP=10
ALLOW_REGISTRATION=false

# PWA / HTTPS (caddy)
# Domain for HTTPS PWA access. Requires DNS/router/hosts entry pointing to this server.
# Caddy auto-generates internal certificates. Install Caddy root CA on Android for trust.
PWA_DOMAIN=checklist-hogar.local
# Set to true when accessing exclusively via HTTPS reverse proxy
# COOKIE_SECURE=true
